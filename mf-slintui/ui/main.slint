import { NavItem } from "components/NavItem.slint";

export component MainWindow inherits Window {
    width: 1000px;
    height: 650px;
    background: white;
    title: "Meltforge";

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: #f3f4f6;

            VerticalLayout {
                spacing: 4px;
                padding: 12px;

                Text {
                    text: "Meltforge";
                    font-size: 20px;
                    font-weight: 600;
                    color: #111111;
                    padding-bottom: 8px;
                }

                NavItem { label: "Convert"; }
                NavItem { label: "Plugins"; }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        Rectangle {
            background: white;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            Text {
                text: "Content Area";
                color: #666;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
