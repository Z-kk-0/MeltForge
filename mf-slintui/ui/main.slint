import { Theme } from "Theme/Theme.slint";
import { Sidebar } from "components/SideBar.slint";
import { PluginsPage } from "pages/plugins.slint";
import { ConvertPage } from "pages/convert.slint";

export component MainWindow inherits Window {
    callback add_file_clicked;
    callback convert_clicked();

    min-width: 960px;
    min-height: 600px;
    vertical-stretch: 1;
    horizontal-stretch: 1;
    background: Theme.bg;
    title: "Meltforge";
    in property <string> app_version: "";
    in-out property <[string]> selected_files: [];
    property <int> current_page: 0;
    HorizontalLayout {
        Sidebar {
            app_version: root.app_version;
            clip: false;
            current: root.current_page;
            select(i) => {
                root.current_page = i;
            }
        }

        if root.current_page == 0: ConvertPage { add_file_clicked => { root.add_file_clicked(); }  files: selected_files; convert_clicked => { root.convert_clicked() }}
        if root.current_page == 1: PluginsPage { }
    }
}


