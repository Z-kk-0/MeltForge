import { Theme } from "../Theme/Theme.slint";
import { ButtonPrimary } from "../components/buttonprimary.slint";

export component ConvertPage inherits Rectangle {
    background: Theme.surface;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    VerticalLayout {
        Rectangle {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            background: Theme.surface;
            horizontal-stretch: 1;
            vertical-stretch: 1;
        }

        Rectangle {
            background: Theme.bg_light;
            horizontal-stretch: 1;
            height: 48px;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    ButtonPrimary { label: "convert"; }
                    padding-right: 20px;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

